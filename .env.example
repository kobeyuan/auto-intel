# ⚠️  重要：此文件不包含真实密钥，仅作为配置模板
# 复制此文件为 .env 并填入你的真实密钥
# .env 文件已被 .gitignore 忽略，不会提交到 Git

# ============================================
# 数据库配置 (Supabase)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# 搜索配置 (Brave Search)
# ============================================
BRAVE_API_KEY=your-brave-api-key

# ============================================
# AI 模型配置
# ============================================
# 默认使用的模型: kimi | gemini | openai
DEFAULT_AI_MODEL=kimi

# Gemini API 配置
GEMINI_API_URL=https://new.lemonapi.site/v1
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=[L]gemini-3-pro-preview

# Kimi (Moonshot) API 配置
KIMI_API_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=your-kimi-api-key
KIMI_MODEL=kimi-k2.5

# ============================================
# 通知配置 (飞书 Webhook - 可选)
# ============================================
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# ============================================
# 部署配置 (可选)
# ============================================
# NEXT_PUBLIC_BASE_URL=http://localhost:3000
